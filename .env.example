# Scipio configuration (environment variables). Precedence: ENV → built-in default.

# HTTP
PORT=8080
BIND=0.0.0.0

# Auth: comma-separated bearer tokens. REQUIRED to bind anything but loopback.
# Without tokens, Scipio clamps BIND to 127.0.0.1 unless ALLOW_INSECURE=true.
API_TOKENS=
ALLOW_INSECURE=false

# Concurrency & queueing
MAX_CONCURRENT_SCRAPES=2
QUEUE_LIMIT=20

# Timeouts (seconds)
JOB_RESULT_TTL_SECONDS=900
SYNC_SCRAPE_TIMEOUT_SECONDS=240
OTP_WAIT_TIMEOUT_SECONDS=300

# Chromium
CHROMIUM_PATH=/usr/bin/chromium
# Extra Chromium launch args (comma/space separated). Add --no-sandbox only if
# your environment requires it.
CHROMIUM_ARGS=

# Optional: enable failure screenshots written to this directory (mount a volume)
# FAILURE_SCREENSHOTS_DIR=/data/screenshots

# Logging: fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=info

# Job-creation rate limit (per token/IP)
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=900
