{
  "name": "scipio",
  "version": "0.0.0",
  "description": "Self-hosted RESTful API around israeli-bank-scrapers",
  "license": "Apache-2.0",
  "author": "Tomer Klein",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t0mer/scipio.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/server.js",
  "bin": {
    "scipio": "dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "node --watch --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^5.1.0",
    "@sinclair/typebox": "^0.34.13",
    "fastify": "^5.2.1",
    "israeli-bank-scrapers-core": "^6.3.0",
    "prom-client": "^15.1.3",
    "puppeteer-core": "^24.43.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.7",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^3.2.4"
  }
}
